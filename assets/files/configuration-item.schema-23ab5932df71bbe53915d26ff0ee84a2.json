{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidestack.dev/docs/reference/jsonschema/metadata/configuration-item.schema.json",
  "title": "单项配置定义",
  "description": "单个 .config.json 资源，定义一个配置项；需要批量数组结构时使用 configuration Schema。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "key",
    "label",
    "valueType"
  ],
  "properties": {
    "key": {
      "type": "string",
      "description": "配置项的稳定键，运行时按此键读取或更新配置值。"
    },
    "label": {
      "type": "string",
      "description": "配置项在管理界面的显示名称。"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "说明该定义的用途、业务含义或使用条件。"
    },
    "modifiable": {
      "type": "boolean",
      "default": false,
      "description": "是否允许通过配置管理机制修改该项，缺省 false。"
    },
    "nullable": {
      "type": "boolean",
      "default": false,
      "description": "配置值是否允许为空，缺省 false。"
    },
    "valueType": {
      "type": "string",
      "enum": [
        "int",
        "long",
        "float",
        "double",
        "boolean",
        "string",
        "object",
        "map",
        "list",
        "array"
      ],
      "description": "配置值类型：int、long、float、double、boolean、string、object、map、list、array。"
    },
    "defaultValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "null"
      ],
      "description": "配置缺省值；字符串原样保存，其他 JSON 值由平台序列化为 JSON 字符串保存。"
    },
    "groupPath": {
      "type": [
        "string",
        "null"
      ],
      "description": "该配置项所属配置分组的路径。"
    },
    "order": {
      "type": [
        "integer",
        "null"
      ],
      "description": "用于同类条目排序的数值。"
    },
    "scope": {
      "type": "string",
      "enum": [
        "frontend",
        "backend"
      ],
      "default": "backend",
      "description": "配置生效范围：frontend 为前端，backend 为后端；未设置时为 backend。"
    },
    "obsolete": {
      "type": "boolean",
      "default": false,
      "description": "是否已废弃该配置项，缺省 false。"
    },
    "obsoleteCause": {
      "type": [
        "string",
        "null"
      ],
      "description": "配置项废弃的原因或替代说明。"
    },
    "editorSchema": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "UI 组件类型，由前端组件注册机制解析，如 page、form、input-text。"
        },
        "name": {
          "type": "string",
          "description": "组件绑定的数据字段名，表单组件通常用它读取和写入表单数据。"
        },
        "id": {
          "type": "string",
          "description": "组件标识，供组件定位或交互引用。"
        },
        "className": {
          "type": [
            "string",
            "object",
            "null"
          ],
          "description": "组件样式类；可使用类名字符串或按条件启用类名的对象。"
        },
        "visible": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "组件是否可见。"
        },
        "hidden": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "组件是否隐藏。"
        },
        "visibleOn": {
          "type": [
            "string",
            "null"
          ],
          "description": "决定组件可见性的前端表达式。"
        },
        "hiddenOn": {
          "type": [
            "string",
            "null"
          ],
          "description": "决定组件隐藏状态的前端表达式。"
        }
      },
      "description": "用于编辑配置值的 UI Schema 组件定义。"
    },
    "managementEntry": {
      "type": [
        "string",
        "null"
      ],
      "description": "配置管理入口的 UI 模型路径。"
    }
  },
  "$comment": "Source: ability/ouroboros-configuration/ouroboros-configuration-core/src/main/java/com/ouroboros/configuration/metadata/ConfigurationMetadata.java; ability/ouroboros-configuration/ouroboros-configuration-core/src/main/java/com/ouroboros/configuration/metadata/ConfigValueType.java; ability/ouroboros-configuration/ouroboros-configuration-core/src/main/java/com/ouroboros/configuration/metadata/ConfigScope.java"
}
