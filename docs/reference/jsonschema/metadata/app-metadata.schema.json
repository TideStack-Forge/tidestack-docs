{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidestack.dev/docs/reference/jsonschema/metadata/app-metadata.schema.json",
  "title": "应用元数据",
  "description": "TideStack metadata schema for app-metadata. Legacy runtime packaging may still use Ouroboros paths.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "logo": {
      "type": [
        "string",
        "null"
      ]
    },
    "homePage": {
      "type": "string"
    },
    "defaultTheme": {
      "type": "string"
    },
    "custom": {
      "type": "object"
    }
  }
}
