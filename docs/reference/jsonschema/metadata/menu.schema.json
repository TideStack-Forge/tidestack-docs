{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidestack.dev/docs/reference/jsonschema/metadata/menu.schema.json",
  "title": "菜单模型",
  "description": "TideStack metadata schema for menu. Legacy runtime packaging may still use Ouroboros paths.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "fullName",
    "title"
  ],
  "properties": {
    "fullName": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "placement": {
      "type": "string",
      "enum": [
        "main",
        "secondary",
        "all"
      ]
    },
    "showMode": {
      "type": "string",
      "enum": [
        "tab",
        "fullScreen",
        "newWindow"
      ]
    },
    "order": {
      "type": "integer"
    }
  }
}
