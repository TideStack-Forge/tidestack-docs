{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tidestack.dev/docs/reference/jsonschema/metadata/schedule.schema.json",
  "title": "定时任务定义",
  "description": "声明按 cron 调度执行的逻辑流及其输入数据，调度行为由平台定时任务机制负责。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "cron",
    "flowName"
  ],
  "properties": {
    "name": {
      "type": "string",
      "description": "定时任务的名称。"
    },
    "description": {
      "type": "string",
      "description": "说明该定义的用途、业务含义或使用条件。"
    },
    "cron": {
      "type": "string",
      "description": "任务的 cron 调度表达式，由平台调度实现解析。"
    },
    "flowName": {
      "type": "string",
      "description": "到达调度时间时执行的逻辑流名称。"
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "调用逻辑流时传入的任务数据对象。"
    }
  },
  "$comment": "Source: ability/ouroboros-scheduler/ouroboros-scheduler-core/src/main/java/com/ouroboros/scheduler/SimpleScheduleTask.java"
}
