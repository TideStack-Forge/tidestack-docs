# 潮汐栈版本号
OUROBOROS_VERSION=2.0.0-rc.1-SNAPSHOT

# 开发平台访问端口
PLATFORM_PORT=80

# 远程调试端口，不需要时可删除 compose 中对应映射
DEBUG_PORT=15005

# MySQL 暴露到宿主机的端口
MYSQL_PORT=13306

# 必填：宿主机 workspace 绝对路径
HOST_WORKSPACE_PATH=/absolute/path/to/tidestack-develop/workspace

# 必填：首次部署前替换为随机强密码
MYSQL_ROOT_PASSWORD=replace-with-a-random-password

# 必填：RabbitMQ 账号和随机强密码
RABBITMQ_DEFAULT_USER=ouroboros
RABBITMQ_DEFAULT_PASS=replace-with-a-random-password

# Apple Silicon 芯片如需 ARM64 镜像可取消注释
# ARCH_AFFIX=-arm64
