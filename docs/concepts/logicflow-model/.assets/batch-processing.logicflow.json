{
  "name": "handbook.batch-processing",
  "description": "批量数据处理示例",
  "entryNode": "校验输入",
  "errorEntryNode": "整理错误",
  "inputDataType": "object",
  "outputDataType": "object",
  "isEnabled": true,
  "nodes": [
    {
      "name": "校验输入",
      "type": "validate",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "schema": {
        "type": "object",
        "required": [
          "items",
          "mode"
        ],
        "properties": {
          "items": {
            "type": "array"
          },
          "mode": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "规范化数据",
      "type": "script",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "language": "groovy",
      "script": "return [mode: $0.mode, items: $0.items.findAll { it != null }.unique()]"
    },
    {
      "name": "选择处理策略",
      "type": "switch",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "快速处理",
          "dataType": "any",
          "exclusiveGroupId": "switch-branches"
        },
        {
          "name": "完整处理",
          "dataType": "any",
          "exclusiveGroupId": "switch-branches"
        },
        {
          "name": "default",
          "dataType": "any",
          "exclusiveGroupId": "switch-branches",
          "defaultBranch": true
        }
      ],
      "conditions": [
        {
          "name": "快速处理",
          "expression": "${mode == \"fast\"}"
        },
        {
          "name": "完整处理",
          "expression": "${mode == \"full\"}"
        }
      ]
    },
    {
      "name": "提取必要字段",
      "type": "mapping",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "mapping": {
        "mode": "${mode}",
        "items": "${items}"
      }
    },
    {
      "name": "快速计算",
      "type": "script",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "language": "groovy",
      "script": "return [strategy: \"fast\", count: $0.items.size(), items: $0.items]"
    },
    {
      "name": "逐项转换",
      "type": "script",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "language": "groovy",
      "script": "return [mode: $0.mode, items: $0.items.collect { [value: it, checked: true] }]"
    },
    {
      "name": "汇总统计",
      "type": "script",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "language": "groovy",
      "script": "return [strategy: \"full\", count: $0.items.size(), items: $0.items]"
    },
    {
      "name": "构造默认结果",
      "type": "mapping",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "mapping": {
        "strategy": "${\"default\"}",
        "count": 0,
        "items": []
      }
    },
    {
      "name": "汇集处理结果",
      "type": "mutex",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ]
    },
    {
      "name": "封装响应",
      "type": "mapping",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "mapping": {
        "success": true,
        "data": "${$0}"
      }
    },
    {
      "name": "返回处理结果",
      "type": "return",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": []
    },
    {
      "name": "整理错误",
      "type": "mapping",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "mapping": {
        "success": false,
        "code": "${exceptionCode}",
        "message": "${exceptionMessage}"
      }
    },
    {
      "name": "返回错误结果",
      "type": "return",
      "isEnabled": true,
      "isAsync": false,
      "inputPorts": [
        {
          "name": "",
          "dataType": "any"
        }
      ],
      "outputPorts": []
    }
  ],
