        <mxCell id="axis-title" value="&lt;b&gt;来源与治理边界&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#0B1F3A;fontSize=20;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="250" height="40" as="geometry"/></mxCell>
