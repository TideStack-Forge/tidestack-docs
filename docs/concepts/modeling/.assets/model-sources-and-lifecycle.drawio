        <mxCell id="platform-package" value="编译进入程序包" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#A9C6EA;fontColor=#264A73;fontSize=15;" vertex="1" parent="1"><mxGeometry x="625" y="225" width="205" height="56" as="geometry"/></mxCell>
