        <mxCell id="managed-source" value="&lt;b&gt;受管自定义定义&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657F&quot; style=&quot;font-size:14px&quot;&gt;特定能力的数据库化管理数据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF8EC;strokeColor=#B45309;strokeWidth=2;fontColor=#0B1F3A;fontSize=18;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="managed-define" value="通过对应管理功能维护" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DDB66F;fontColor=#5F420F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="525" width="205" height="56" as="geometry"/></mxCell>
        <mxCell id="managed-package" value="由该能力管理持久化与版本边界" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DDB66F;fontColor=#5F420F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="625" y="525" width="205" height="56" as="geometry"/></mxCell>
        <mxCell id="managed-load" value="由专用 Provider 投影到运行时" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DDB66F;fontColor=#5F420F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="860" y="525" width="205" height="56" as="geometry"/></mxCell>
        <mxCell id="managed-runtime" value="按对应能力的启停与刷新规则生效" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DDB66F;fontColor=#5F420F;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1095" y="525" width="235" height="56" as="geometry"/></mxCell>

        <mxCell id="note" value="来源决定模型由谁定义和如何治理；阶段决定模型何时被发现、装载与执行。两者不能混为同一分类。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#F7F7FB;strokeColor=#9EA6B4;fontColor=#39475A;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="205" y="655" width="990" height="48" as="geometry"/></mxCell>

