        <mxCell id="phase-define" value="&lt;b&gt;定义 / 编码&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657F&quot; style=&quot;font-size:14px&quot;&gt;形成模型或扩展契约&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FD;strokeColor=#7AA7DE;strokeWidth=1.5;fontColor=#0B1F3A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="390" y="90" width="205" height="70" as="geometry"/></mxCell>
        <mxCell id="phase-package" value="&lt;b&gt;版本 / 打包&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657F&quot; style=&quot;font-size:14px&quot;&gt;形成可交付资产&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FD;strokeColor=#7AA7DE;strokeWidth=1.5;fontColor=#0B1F3A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="625" y="90" width="205" height="70" as="geometry"/></mxCell>
        <mxCell id="phase-load" value="&lt;b&gt;启动 / 加载&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#52657F&quot; style=&quot;font-size:14px&quot;&gt;发现、校验与装配&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF4FD;strokeColor=#7AA7DE;strokeWidth=1.5;fontColor=#0B1F3A;fontSize=17;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="205" height="70" as="geometry"/></mxCell>
