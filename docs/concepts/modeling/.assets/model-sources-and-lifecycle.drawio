        <mxCell id="app-define" value="在设计时定义与校验" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8BC5B9;fontColor=#285D54;fontSize=15;" vertex="1" parent="1"><mxGeometry x="390" y="375" width="205" height="56" as="geometry"/></mxCell>
        <mxCell id="app-package" value="进入应用版本" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#8BC5B9;fontColor=#285D54;fontSize=15;" vertex="1" parent="1"><mxGeometry x="625" y="375" width="205" height="56" as="geometry"/></mxCell>
