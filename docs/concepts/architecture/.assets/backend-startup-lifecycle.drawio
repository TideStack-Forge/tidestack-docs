          <mxGeometry as="geometry" x="816" y="892" width="322" height="30" />
        </mxCell>
        <mxCell id="note-9" value="执行数据初始化，再发布逻辑流运行快照。" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=18;fontColor=#52657f;align=left;verticalAlign=middle;fontStyle=0;whiteSpace=wrap;">
