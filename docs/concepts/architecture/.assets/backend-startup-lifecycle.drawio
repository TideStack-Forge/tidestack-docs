        </mxCell>
        <mxCell id="note-12" value="启动／刷新期间返回 HTTP 503；运行中刷新复用六个阶段，失败后需成功完成一次完整刷新才能恢复受保护的业务执行。" vertex="1" parent="1" style="text;html=0;strokeColor=none;fillColor=none;fontFamily=PingFang SC;fontSize=17;fontColor=#52657f;align=left;verticalAlign=middle;fontStyle=0;whiteSpace=wrap;">
